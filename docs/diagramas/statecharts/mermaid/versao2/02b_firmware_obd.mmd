stateDiagram-v2
    state "Aguardando a Raspberry Pi" as AGUARDA
    AGUARDA : não fala com o carro
    state "Conversando com o carro" as ATIVO
    state "Bloqueado" as BLOQUEADO
    BLOQUEADO : não fala mais com o carro até ser religado
    [*] --> AGUARDA
    AGUARDA --> ATIVO : a Raspberry Pi está conectada
    ATIVO --> AGUARDA : a Raspberry Pi sumiu por 3 segundos
    ATIVO --> BLOQUEADO : 3ª falha na rede, ou tentou enviar algo proibido

    state ATIVO {
        state "Escutando o carro" as ESCUTANDO
        ESCUTANDO : só ouve, por 1 segundo
        state "Rede incompatível" as REDE
        REDE : velocidade diferente ou fio em curto, sem transmitir nada
        state "Lendo o carro" as LENDO
        LENDO : pergunta velocidade, rotação e temperatura
        state "Carro sem resposta" as SEM_RESPOSTA
        SEM_RESPOSTA : provavelmente desligado
        state "Falha na rede" as FALHA
        FALHA : volta a só ouvir e conta a falha
        [*] --> ESCUTANDO
        ESCUTANDO --> REDE : rede diferente do esperado
        REDE --> ESCUTANDO : depois de 10 segundos
        ESCUTANDO --> LENDO : tudo normal
        LENDO --> SEM_RESPOSTA : 2 segundos sem resposta
        SEM_RESPOSTA --> ESCUTANDO : tenta de novo em alguns segundos
        LENDO --> FALHA : erro ao perguntar
        FALHA --> ESCUTANDO : depois de 10 segundos
    }

    note right of ATIVO
        O ESP32 só pergunta ao carro; nunca envia comandos para ele.
        Só a falha ao perguntar conta para o bloqueio, pois com a rede incompatível ele nem transmite.
        Este é o comportamento projetado: no firmware, ele ainda está sendo programado.
    end note
