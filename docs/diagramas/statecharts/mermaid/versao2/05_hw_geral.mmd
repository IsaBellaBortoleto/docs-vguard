stateDiagram-v2
    direction LR
    state "No carro" as CARRO
    state CARRO {
        state "12 V do carro" as V12
        V12 : acendedor ou pino 16 da tomada OBD-II
        state "Tomada OBD-II" as OBD
        OBD : rede CAN do carro, 500 kbit/s
    }

    state "Gabinete do V-GUARD" as GABINETE
    state GABINETE {
        state "Alimentação" as ALIM
        ALIM : carregador USB 54 W e conversor LM2596 (sem fusível externo na linha Pi-ESP32)
        state "Raspberry Pi 4" as PI
        PI : visão, eventos e envio, com Wi-Fi integrado
        state "Cartão microSD 128 GB" as SD
        SD : banco de dados e fotos (slot interno Pi)
        state "ESP32" as ESP
        ESP : aquisição dos dados do carro
        state "IMU 6 eixos (ADXL345)" as IMU
        IMU : aceleração e dinâmica veicular
        state "Módulo CAN (MCP2515 + TJA1050)" as CANT
        CANT : interface SPI com transceptor para rede CAN
        state "Receptor GNSS" as GNSS
        GNSS : posição, hora e pulso PPS
        state "Módulo 4G A7670E" as LTE
        LTE : internet pela rede celular, com chip de dados
    }

    state "Fora do gabinete" as FORA
    state FORA {
        state "Câmera OV5647" as CAM
        CAM : visão noturna com LEDs IR, voltada ao motorista
        state "Antena GNSS" as ANT_GNSS
        state "Antena 4G" as ANT_LTE
    }

    V12 --> ALIM : 12 V
    ALIM --> PI : 5 V pelo USB-C
    ALIM --> LTE : 5 V, ramo próprio
    PI --> ESP : Cabo USB (dados, 5 V e GND comum - sem fusível e sem UART)
    ESP --> PI : Leituras e telemetria via USB serial
    CAM --> PI : Cabo flat CSI
    GNSS --> PI : UART e PPS
    PI --> LTE : Cabo USB (porta USB2.0_1)
    PI --> SD : Slot do cartão microSD
    IMU --> ESP : I²C (GPIO21 SDA, GPIO22 SCL, 3V3 no CS e GND)
    ESP --> CANT : SPI (GPIO25 CS, GPIO23 SI, GPIO19 SO, GPIO18 SCK, GND pino 14)
    CANT --> OBD : CAN-H (pino 8 para pino 6) e CAN-L (pino 9 para pino 14)
    ANT_GNSS --> GNSS
    ANT_LTE --> LTE

    note right of GABINETE
        A Raspberry Pi conecta ao ESP32 diretamente por cabo USB, que já realiza
        as conexões de GND, provê alimentação 5 V e canal de dados (sem fusíveis e sem UART por GPIO).
        O módulo CAN conecta ao ESP32 via SPI com pinos definidos no esquemático.
    end note
