stateDiagram-v2
    state "12 V do carro" as V12
    V12 : acendedor ou pino 16 da tomada OBD-II

    state "Proteção e conversão" as CONVERSAO
    state CONVERSAO {
        state "Fusível" as FUS
        FUS : protege contra curto-circuito
        state "Carregador USB veicular 54 W" as CARREG
        CARREG : 12 V para 5 V, saída USB-C
        state "Conversor LM2596" as LM
        LM : 12 V para 5 V, ramo só do 4G
        state "Capacitor reservatório" as CAP
        CAP : segura os picos de corrente do 4G
        FUS --> CARREG : 12 V protegido
        FUS --> LM : 12 V protegido
        LM --> CAP : 5 V
    }

    state "Consumidores" as CARGAS
    state CARGAS {
        state "Raspberry Pi 4" as PI
        PI : até 3 A
        state "Módulo 4G A7670E" as LTE
        LTE : picos de corrente ao transmitir
        state "ESP32" as ESP
        ESP : uma fonte só por vez
        state "Câmera OV5647 e LEDs IR" as CAM
        state "Receptor GNSS" as GNSS
        state "IMU" as IMU
        state "Módulo CAN MCP2515" as CANT
        CANT : transceptor TJA1050 e controlador MCP2515
        PI --> ESP : 5 V e GND via cabo USB (sem fusível e sem pinos GPIO)
        PI --> CAM : pela fita CSI
        PI --> GNSS : 3,3 V
        ESP --> IMU : 3,3 V
        ESP --> CANT : 5 V (pino VIN/5V para pino 7 VCC) e GND (pino 14 para pino 6 GND)
    }

    V12 --> FUS : 12 V
    CARREG --> PI : 5 V pelo USB-C
    CAP --> LTE : 5 V

    note right of CARGAS
        O 4G puxa picos de corrente ao transmitir: o ramo próprio e o capacitor
        evitam que a Raspberry Pi reinicie por queda de tensão.
        O cabo USB entre Raspberry Pi e ESP32 já realiza a conexão do GND comum
        e o fornecimento de 5 V, eliminando o uso de fusíveis e conexões UART por GPIO.
        O módulo CAN tem seu GND e 5 V providos pelo ESP32.
    end note
